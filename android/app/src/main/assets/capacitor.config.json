{
	"appId": "com.motodrive.dz",
	"appName": "MotoDrive",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#020617"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"backgroundColor": "#020617",
			"showSpinner": false,
			"splashFullScreen": true,
			"splashImmersive": true
		}
	}
}
