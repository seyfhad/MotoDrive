rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.email == 'seyfhad@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // System Config & Pricing (accessible for tariff display and owner passcode updates)
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Health & Connection Test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Service Areas (coverage inspection & owner configuration)
    match /service_areas/{areaId} {
      allow read, write: if true;
    }
    match /serviceAreas/{areaId} {
      allow read, write: if true;
    }

    // Promo Codes
    match /promo_codes/{codeId} {
      allow read, write: if true;
    }

    // Users collection (supports phone-direct registration & owner management)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Driver Applications Collection (Driver registration metadata & 4-documents review workflow)
    match /driver_applications/{applicationId} {
      allow read, write: if true;
    }

    // Ride Requests Collection (Real-time onSnapshot incoming rides stream)
    match /ride_requests/{requestId} {
      allow read, write: if true;
    }

    // Drivers collection (supports phone-direct registration & owner approval/rejection)
    match /drivers/{driverId} {
      allow read, write: if true;

      // Driver ratings and feedback subcollection
      match /ratings/{ratingId} {
        allow read, write: if true;
      }
    }

    // Rides collection
    match /rides/{rideId} {
      allow read, write: if true;

      // Ride Offers subcollection
      match /offers/{offerId} {
        allow read, write: if true;
      }
    }

    // Ratings collection
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Complaints collection
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
