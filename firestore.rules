rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@.+]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.email == 'seyfhad@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Prevent plaintext passwords or oversized payloads on user documents
    function isValidUserPayload(data) {
      return !('password' in data) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('role' in data) || data.role in ['passenger', 'driver', 'admin']);
    }

    function isProfileIdentityUnchanged() {
      return (!('phone' in existing()) || incoming().phone == existing().phone) &&
             (!('name' in existing()) || existing().name in ['راكب MotoDrive', 'سائق MotoDrive', 'مستخدم MotoDrive', 'ضيف MotoDrive'] || incoming().name == existing().name) &&
             (!('photoUrl' in existing()) || existing().photoUrl == '' || incoming().photoUrl == existing().photoUrl);
    }

    function isValidDriverPayload(data) {
      return !('password' in data) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // System Config & Pricing (Admin only write)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Health & Connection Test
    match /test/{docId} {
      allow read, write: if true;
    }

    // Service Areas (Admin only write)
    match /service_areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /serviceAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo Codes (Admin only write)
    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUserPayload(incoming());
      allow update: if isValidId(userId) && isValidUserPayload(incoming()) && (isAdmin() || (isSignedIn() && request.auth.uid == userId) || isProfileIdentityUnchanged());
      allow delete: if isAdmin();
    }

    // Driver Applications Collection (Admin write/delete only)
    match /driver_applications/{applicationId} {
      allow read: if true;
      allow create: if isValidId(applicationId);
      allow update, delete: if isAdmin();
    }

    // Ride Requests Collection (Public read & write for real-time dispatch)
    match /ride_requests/{requestId} {
      allow read, write: if true;
    }

    // Drivers collection (Public read & update for location / online status)
    match /drivers/{driverId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();

      match /ratings/{ratingId} {
        allow read, write: if true;
      }
    }

    // Rides collection (Public read & write for instant passenger-driver interaction)
    match /rides/{rideId} {
      allow read, write: if true;

      match /offers/{offerId} {
        allow read, write: if true;
      }

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Ratings collection
    match /ratings/{ratingId} {
      allow read, write: if isSignedIn();
    }

    // Complaints collection
    match /complaints/{complaintId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
